      "additionalProperties": false,
      "description": "Per-asset limits. Set in an asset JSON's own optimize, it also replaces the per-texture ceiling (each texture's VRAM must fit its slot's maxSize and codec as set without the asset JSON's overrides)."
    },
    "__schema26": {
      "description": "Estimated GPU memory of the whole asset in MB: its textures (KTX2 at 1 B/px, the most it takes on any device) plus a GLB's geometry (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema27"
        }
      ],
      "$ref": "#/definitions/__schema28"
    },
    "__schema27": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema28": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema27"
        }
      ]
    },
    "__schema29": {
      "description": "The output file's size in MB (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema27"
        }
      ],
      "$ref": "#/definitions/__schema28"
    },
    "__schema30": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "The material's alphaTest (0-1, eg. 0.5): each mip level's alpha is scaled so the share of it passing this cut stays level 0's, so thin alpha-cut features (leaves, trunks, an impostor's edges) don't thin out with distance. Needs an alpha channel and mipmaps; not for a normal or data slot, or normalMode (their alpha isn't coverage). Default: off."
    },
    "__schema31": {
      "description": "Width and height the channels are combined at (default: the sources' size, which must then agree). The optimize step resizes the result to its maxSize.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema32"
        }
      ]
    },
    "__schema32": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "__schema33": {
      "type": "object",
      "properties": {
        "r": {
          "$ref": "#/definitions/__schema34"
        },
        "g": {
          "$ref": "#/definitions/__schema46"
        },
        "b": {
          "$ref": "#/definitions/__schema47"
        },
        "a": {
          "$ref": "#/definitions/__schema48"
        },
        "rg": {
          "$ref": "#/definitions/__schema49"
        },
        "rgb": {
          "$ref": "#/definitions/__schema50"
        },
        "rgba": {
          "$ref": "#/definitions/__schema51"
        }
      },
      "additionalProperties": false,
      "description": "Per output channel or channel group: a source channel, or a constant."
    },
    "__schema34": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema35": {
      "anyOf": [
        {
          "type": "number",
          "description": "A constant (0..1, linear) in every channel of the target."
        },
        {
          "type": "object",
          "properties": {
            "src": {
              "$ref": "#/definitions/__schema36"
            },
            "channel": {
              "description": "The channels of `src`, one per target channel (default: the target's own, eg. \"rgb\"). A greyscale image has its grey in r, g and b.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema37"
                }
              ]
            },
            "colorSpace": {
              "description": "How `src` is encoded (alpha is always linear). Default: srgb for the colour channels of an sRGB texture (texOpts.colorSpace), else linear.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema38"
                }
              ]
            },
            "normal": {
              "description": "`src` is a normal map: it is resized as unit vectors, before its channels are taken. Only `invert` applies.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema39"
                }
              ]
            },
            "remap": {
              "description": "Maps [min, max] to 0..1; auto: the full range of the channels taken.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema40"
                }
              ]
            },
            "invert": {
              "description": "1 − value, after remap (eg. a DirectX normal's G).",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema41"
                }
              ]
            },
            "multiply": {
              "anyOf": [
                {
                  "$ref": "#/definitions/__schema42"
                },
                {
                  "$ref": "#/definitions/__schema43"
                }
              ],
              "description": "Multiplied in after remap and invert (linear values), eg. AO into the albedo."
            }
          },
          "required": [
            "src"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema36": {
      "type": "string",
      "description": "A source image relative to this JSON (\"./source/ao.png\"), or a URL path served from src/public. 8 or 16 bits."
    },
    "__schema37": {
      "type": "string",
      "pattern": "^[rgba]{1,4}$"
    },
    "__schema38": {
      "type": "string",
      "enum": [
        "srgb",
        "linear"
      ]
    },
    "__schema39": {
      "type": "boolean"
    },
    "__schema40": {
      "anyOf": [
        {
          "type": "string",
          "const": "auto"
        },
        {
          "type": "array",
          "items": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "additionalItems": false
        }
      ]
    },
    "__schema41": {
      "type": "boolean"
    },
    "__schema42": {
      "type": "number",
      "description": "A constant factor."
    },
    "__schema43": {
      "type": "object",
      "properties": {
        "src": {
          "$ref": "#/definitions/__schema36"
        },
        "channel": {
          "description": "The channel of `src` (default r).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema44"
            }
          ]
        },
        "strength": {
          "description": "value × (1 + (factor − 1) × strength), eg. 0.8 for AO into albedo (default 1).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema45"
            }
          ]
        }
      },
      "required": [
        "src"
      ],
      "additionalProperties": false
    },
    "__schema44": {
      "type": "string",
      "enum": [
        "r",
        "g",
        "b",
        "a"
      ]
    },
    "__schema45": {
      "type": "number",
      "minimum": 0
    },
    "__schema46": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema47": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema48": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema49": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema50": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema51": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema35"
        }
      ]
    },
    "__schema52": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "__schema53": {
      "type": "object",
      "properties": {
        "in": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    }
