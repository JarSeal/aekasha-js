{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/definitions/__schema0"
    },
    "id": {
      "$ref": "#/definitions/__schema1"
    },
    "items": {
      "$ref": "#/definitions/__schema3"
    },
    "source": {
