        },
        "comments": {
          "$ref": "#/definitions/__schema75"
        },
        "todo": {
          "$ref": "#/definitions/__schema77"
        },
        "debugObj": {
          "$ref": "#/definitions/__schema79"
        }
      },
      "additionalProperties": false,
      "description": "What the debug tools show for it. Production data has none."
    },
    "__schema71": {
      "description": "The name the debug tools show.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema72"
        }
      ]
    },
    "__schema72": {
      "type": "string"
    },
    "__schema73": {
