      "allOf": [
        {
          "$ref": "#/definitions/__schema74"
        }
      ]
    },
    "__schema74": {
      "type": "string"
    },
    "__schema75": {
      "description": "Notes with their times.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema76"
        }
      ]
    },
    "__schema76": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "timestamp": {
            "type": "number",
            "description": "Milliseconds since the UNIX epoch."
          },
          "comment": {
            "type": "string",
            "description": "The note."
          }
        },
        "required": [
          "timestamp",
          "comment"
        ],
        "additionalProperties": false
      }
    },
    "__schema77": {
      "description": "Open items, by key.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema78"
        }
      ]
    },
    "__schema78": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema79": {
      "description": "Anything else a debug tool keeps for it.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema80"
        }
      ]
    },
    "__schema80": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema81": {
      "type": "string",
      "description": "Set by the gatherer: the JSON file the asset came from. Not written by hand."
    }
  }
}