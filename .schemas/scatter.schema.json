    }
  },
  "required": [
    "items",
    "source"
  ],
  "additionalProperties": false,
  "description": "A scatter: static instances of its items, placed by its source, drawn in cells.",
  "definitions": {
    "__schema0": {
      "type": "string",
      "description": "The JSON Schema in .schemas/ an editor validates this file with. The gatherer ignores it."
    },
    "__schema1": {
      "description": "The id. Default: the file name without .scatter.json.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema2"
        }
      ]
    },
    "__schema2": {
      "type": "string",
      "minLength": 1
    },
    "__schema3": {
      "minItems": 1,
      "maxItems": 256,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema4"
      },
      "description": "The kinds of instance (at most 256): each a geometry and a material."
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "geometry": {
          "$ref": "#/definitions/__schema5"
        },
        "material": {
          "$ref": "#/definitions/__schema6"
        },
        "weight": {
          "$ref": "#/definitions/__schema7"
        },
        "castShadow": {
          "$ref": "#/definitions/__schema9"
        },
        "receiveShadow": {
          "$ref": "#/definitions/__schema11"
        },
        "collider": {
          "$ref": "#/definitions/__schema13"
        }
      },
      "required": [
        "geometry",
        "material"
      ],
      "additionalProperties": false,
      "description": "One kind of instance: its geometry and material, and its share of the instances."
    },
    "__schema5": {
      "type": "string",
      "minLength": 1,
      "description": "A registered geometry's id: a *.geometry.json's (the gather adds it to the scene), an import's <importId>/<node> or one code registers."
    },
    "__schema6": {
      "type": "string",
      "minLength": 1,
      "description": "A registered material's id: a *.material.json's (the gather adds it to the scene) or one code registers."
    },
    "__schema7": {
      "description": "The item's share where a source doesn't pick it: its weight over the items' sum. Default 1.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema8"
        }
      ]
    },
    "__schema8": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema9": {
      "description": "Casts shadows. Default: false.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema10"
        }
      ]
    },
    "__schema10": {
      "type": "boolean"
    },
    "__schema11": {
      "description": "Receives shadows. Default: true.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema12"
        }
      ]
    },
    "__schema12": {
      "type": "boolean"
    },
    "__schema13": {
      "description": "A FIXED collider per instance (needs physics()): CONVEXHULL (its geometry's points, scaled as the instance is), BALL (its bounding sphere) or NONE (default). Only for large pieces: past 200 a target, the gather and the spawn warn.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema14"
        }
      ]
    },
    "__schema14": {
      "type": "string",
      "enum": [
        "CONVEXHULL",
        "BALL",
        "NONE"
      ]
    },
    "__schema15": {
      "oneOf": [
        {
          "$ref": "#/definitions/__schema16"
        },
        {
          "$ref": "#/definitions/__schema23"
        },
        {
          "$ref": "#/definitions/__schema41"
        }
      ],
      "description": "Where the instances go: PROCEDURAL (a registered generator), PLACEMENTS (a list) or IMPORTED (an import's GPU instances and point clouds)."
    },
    "__schema16": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/__schema17"
        },
        "generator": {
          "$ref": "#/definitions/__schema18"
        },
        "params": {
          "$ref": "#/definitions/__schema19"
        },
        "seed": {
          "$ref": "#/definitions/__schema21"
        }
      },
      "required": [
        "type",
        "generator"
      ],
      "additionalProperties": false,
      "description": "Instances placed by a registered generator when the scatter spawns."
    },
    "__schema17": {
      "type": "string",
      "const": "PROCEDURAL",
      "description": "Places the instances by a generator."
    },
    "__schema18": {
      "type": "string",
      "minLength": 1,
      "description": "The generator's id (registerScatterGenerator)."
    },
    "__schema19": {
      "description": "The generator's own params, checked by the generator. Default: {}.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema20"
        }
      ]
    },
    "__schema20": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "__schema21": {
      "description": "The seed (default 0), combined with the world seed, the target's grid place and the scatter's id, so every block gets its own placements and every visit the same.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema22"
        }
      ]
    },
    "__schema22": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/__schema24"
        },
        "placements": {
          "$ref": "#/definitions/__schema25"
        },
        "seed": {
          "$ref": "#/definitions/__schema39"
        }
      },
      "required": [
        "type",
        "placements"
      ],
      "additionalProperties": false,
      "description": "Hand-placed instances (or a tool's)."
    },
    "__schema24": {
      "type": "string",
      "const": "PLACEMENTS",
      "description": "Hand-placed instances (or a tool's)."
    },
    "__schema25": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema26"
      },
      "description": "The instances."
    },
    "__schema26": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/definitions/__schema27"
        },
        "yaw": {
          "$ref": "#/definitions/__schema31"
        },
        "quaternion": {
          "$ref": "#/definitions/__schema33"
        },
        "scale": {
          "$ref": "#/definitions/__schema35"
        },
        "item": {
          "$ref": "#/definitions/__schema37"
        }
      },
      "required": [
        "position"
      ],
      "additionalProperties": false,
      "description": "One hand-placed instance, relative to the target position."
    },
    "__schema27": {
      "type": "array",
      "items": [
        {
          "$ref": "#/definitions/__schema28"
        },
        {
          "$ref": "#/definitions/__schema29"
        },
        {
          "$ref": "#/definitions/__schema30"
        }
      ],
      "description": "[x, y, z] in metres, from the target's position (a terrain block's centre).",
      "minItems": 3,
      "maxItems": 3,
      "additionalItems": false
    },
    "__schema28": {
      "type": "number"
    },
    "__schema29": {
      "type": "number"
    },
    "__schema30": {
      "type": "number"
    },
    "__schema31": {
      "description": "The rotation about +y, in radians. Default 0. Not with quaternion.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema32"
        }
      ]
    },
    "__schema32": {
      "type": "number"
    },
    "__schema33": {
      "description": "The rotation as a quaternion [x, y, z, w]. Not with yaw.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema34"
        }
      ]
    },
    "__schema34": {
      "type": "array",
      "items": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "additionalItems": false
    },
    "__schema35": {
      "description": "The scale, the same on every axis. Default 1.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema36"
        }
      ]
    },
    "__schema36": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema37": {
      "description": "The item's index in items. Default: one picked by the weights, from the seed.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema38"
        }
      ]
    },
    "__schema38": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "__schema39": {
      "description": "The seed the items without item are picked from (default 0), combined as a generator's.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema40"
        }
      ]
    },
    "__schema40": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema41": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/definitions/__schema42"
        },
        "importedAsset": {
          "$ref": "#/definitions/__schema43"
        },
        "nodes": {
          "$ref": "#/definitions/__schema44"
        },
        "seed": {
          "$ref": "#/definitions/__schema47"
        }
      },
      "required": [
        "type",
        "importedAsset"
      ],
      "additionalProperties": false,
      "description": "An import's instances: a GPU-instanced node's item is the one whose geometry is the node's, or a plain node's of the same glTF mesh; a point's is its _ITEM."
    },
    "__schema42": {
      "type": "string",
      "const": "IMPORTED",
      "description": "The instances of an import's nodes."
    },
    "__schema43": {
      "type": "string",
      "minLength": 1,
      "description": "The *.importedAsset.json's id (the gather adds it to the scene). Its nodes of GPU instances (EXT_mesh_gpu_instancing) and its point clouds (aekScatterPoints) are the instances, placed from the target's position as they are from the file's root."
    },
    "__schema44": {
      "description": "The nodes to take, by their name or a parent's (Blender writes a Geometry Nodes output as children of its object's node), * matching any run of characters (Rocks*). Default: every node of GPU instances and every point cloud.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema45"
        }
      ]
    },
    "__schema45": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema46"
      }
    },
    "__schema46": {
      "type": "string",
      "minLength": 1
    },
    "__schema47": {
      "description": "The seed the points without an _ITEM are picked from (default 0), combined as a generator's.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema48"
        }
      ]
    },
    "__schema48": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "__schema49": {
      "description": "A cell's side in metres: each cell is one draw per item, culled and switched as a whole. Default 16.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema50"
        }
      ]
    },
    "__schema50": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema51": {
      "description": "Every cell's levels of detail; cullScreenSize hides a cell too small on screen. Default: none.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema52"
        }
      ]
    },
    "__schema52": {
      "type": "object",
      "properties": {
        "levels": {
          "$ref": "#/definitions/__schema53"
        },
        "cullScreenSize": {
          "$ref": "#/definitions/__schema62"
        },
        "hysteresis": {
          "$ref": "#/definitions/__schema64"
        },
        "bias": {
          "$ref": "#/definitions/__schema66"
        },
        "fadeSeconds": {
          "$ref": "#/definitions/__schema68"
        }
      },
      "required": [
        "levels"
      ],
      "additionalProperties": false,
      "description": "Levels of detail (p348): each frame the mesh shows the level its screen size reaches, swapping its geometry, material and castShadow, cross-faded over fadeSeconds."
    },
    "__schema53": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema54"
      },
      "description": "Level 0 (the finest) first, screenSize descending."
    },
    "__schema54": {
      "type": "object",
      "properties": {
        "screenSize": {
          "$ref": "#/definitions/__schema55"
        },
        "geo": {
          "$ref": "#/definitions/__schema56"
        },
        "mat": {
          "$ref": "#/definitions/__schema58"
        },
        "castShadow": {
          "$ref": "#/definitions/__schema60"
        }
      },
      "required": [
        "screenSize"
      ],
      "additionalProperties": false,
      "description": "A level of detail."
    },
    "__schema55": {
      "type": "number",
      "minimum": 0,
      "description": "Smallest screen size (bounding-sphere diameter / viewport height) this level is used at. Coarser levels need smaller values. Moving to a coarser level waits for `hysteresis` below it."
    },
    "__schema56": {
      "description": "Registered geometry id (the scene must load it). Omitted = the previous level's (level 0: the mesh's own).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema57"
        }
      ]
    },
    "__schema57": {
      "type": "string",
      "minLength": 1
    },
    "__schema58": {
      "description": "Registered material id (the scene must load it). Omitted = the previous level's (level 0: the mesh's own).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema59"
        }
      ]
    },
    "__schema59": {
      "type": "string",
      "minLength": 1
    },
    "__schema60": {
      "description": "Omitted = the previous level's (level 0: the mesh's own).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema61"
        }
      ]
    },
    "__schema61": {
      "type": "boolean"
    },
    "__schema62": {
      "description": "Below this screen size the mesh is hidden (with hysteresis, like the levels). 0 = never hidden. Default 0.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema63"
        }
      ]
    },
    "__schema63": {
      "type": "number",
      "minimum": 0
    },
    "__schema64": {
      "description": "Moving to a coarser level (or hiding) waits until the screen size is this fraction below the threshold, so a mesh on a boundary does not flip every frame. Default 0.1.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema65"
        }
      ]
    },
    "__schema65": {
      "type": "number",
      "minimum": 0,
      "exclusiveMaximum": 1
    },
    "__schema66": {
      "description": "Multiplies the screen size: >1 keeps detail longer. Default 1. The global bias (AppConfig.lod.bias, setLodBias) applies on top.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema67"
        }
      ]
    },
    "__schema67": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "__schema68": {
      "description": "How long a level change (or hiding and showing) cross-fades with a dither, in seconds; 0 switches at once and leaves the level materials undithered. Default AppConfig.lod.fadeSeconds (0.25, setLodFadeSeconds).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema69"
        }
      ]
    },
    "__schema69": {
      "type": "number",
      "minimum": 0
    },
    "__schema70": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/definitions/__schema71"
        },
        "description": {
