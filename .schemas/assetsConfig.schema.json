{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaults": {
      "description": "Merged over the engine's built-in defaults (devTools/assetPipeline/settings.ts).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema0"
        }
      ]
    },
    "profiles": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "#/definitions/__schema0"
      }
    },
    "rules": {
      "description": "Applied in order (later wins) to every asset whose source path matches.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema19"
        }
      ]
    }
  },
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "object",
      "properties": {
        "textures": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema1"
            }
          ]
        },
        "mesh": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema10"
            }
          ]
        },
        "budget": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema14"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "default": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "baseColor": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "normal": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "metallicRoughness": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "occlusion": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "emissive": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "orm": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        },
        "data": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema2"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema2": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "enum": [
            "uastc",
            "etc1s",
            "none"
          ],
          "description": "uastc: 1 B/px on every device (BC7 / ASTC 4×4), the default. etc1s: smallest download, colour slots only. none: not encoded (exact data, CPU readback)."
        },
        "maxSize": {
          "description": "Largest side in px, downscaled to fit (null: the source size).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema3"
            }
          ]
        },
        "mipmaps": {
          "description": "Write the full mip chain (default true).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema4"
            }
          ]
        },
        "level": {
          "description": "UASTC only: --uastc-quality, 0 (fastest) to 4 (slowest).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema5"
            }
          ]
        },
        "rdo": {
          "description": "UASTC only: RDO lambda (0: off). 2 for colour, 1 for normal / ORM / data.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema6"
            }
          ]
        },
        "zstd": {
          "description": "UASTC only: Zstandard supercompression level (0: off).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema7"
            }
          ]
        },
        "quality": {
          "description": "ETC1S only: --qlevel, 1 to 255.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "normalMode": {
          "description": "Two-channel normal map (X in RGB, Y in A). Needs a material that unpacks it.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema9"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema4": {
      "type": "boolean"
    },
    "__schema5": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "__schema6": {
      "type": "number",
      "minimum": 0
    },
    "__schema7": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "__schema8": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "__schema9": {
      "type": "boolean"
    },
    "__schema10": {
      "type": "object",
      "properties": {
        "codec": {
          "description": "Geometry compression. meshopt (default) also shrinks VRAM when quantized.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema11"
            }
          ]
        },
        "quantize": {
          "description": "Quantize, reorder and filter the vertices. false: lossless (EXT_meshopt_compression alone), the collider default.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema12"
            }
          ]
        },
        "simplify": {
          "description": "Target triangle ratio (null: off).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema13"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema11": {
      "type": "string",
      "enum": [
        "meshopt",
        "draco",
        "none"
      ]
    },
    "__schema12": {
      "type": "boolean"
    },
    "__schema13": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema14": {
      "type": "object",
      "properties": {
        "vramMB": {
          "$ref": "#/definitions/__schema15"
        },
        "downloadMB": {
          "$ref": "#/definitions/__schema18"
        }
      },
      "additionalProperties": false,
      "description": "Per-asset limits. Set in an asset JSON's own optimize, it also replaces the per-texture ceiling (each texture's VRAM must fit its slot's maxSize and codec as set without the asset JSON's overrides)."
    },
    "__schema15": {
      "description": "Estimated GPU memory of the whole asset in MB: its textures (KTX2 at 1 B/px, the most it takes on any device) plus a GLB's geometry (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema16"
        }
      ],
      "$ref": "#/definitions/__schema17"
    },
    "__schema16": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema17": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema16"
        }
      ]
    },
    "__schema18": {
      "description": "The output file's size in MB (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema16"
        }
      ],
      "$ref": "#/definitions/__schema17"
    },
    "__schema19": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "glob": {
            "type": "string",
            "description": "Matched against the source file path relative to the repo root (eg. \"src/app/props/**/*.glb\"). Supports **, *, ? and {a,b}."
          },
          "optimize": {
            "description": "Pass the matched assets through as they are. Wins over everything else.",
            "allOf": [
              {
                "$ref": "#/definitions/__schema20"
              }
            ]
          },
          "profile": {
            "description": "A profile of assets.config.json.",
            "allOf": [
              {
                "$ref": "#/definitions/__schema21"
              }
            ]
          },
          "slot": {
            "description": "A standalone texture's slot (default: default). A GLB's textures are classified by their material slot.",
            "allOf": [
              {
                "$ref": "#/definitions/__schema22"
              }
            ]
          },
          "textures": {
            "description": "Per-slot overrides, or false to keep the textures as they are.",
            "allOf": [
              {
                "$ref": "#/definitions/__schema23"
              }
            ]
          },
          "mesh": {
            "description": "Overrides, or false to keep the geometry as it is.",
            "allOf": [
              {
                "$ref": "#/definitions/__schema24"
              }
            ]
          },
          "budget": {
            "allOf": [
              {
                "$ref": "#/definitions/__schema14"
              }
            ]
          }
        },
        "required": [
          "glob"
        ],
        "additionalProperties": false
      }
    },
    "__schema20": {
      "type": "boolean",
      "const": false
    },
    "__schema21": {
      "type": "string"
    },
    "__schema22": {
      "type": "string",
      "enum": [
        "default",
        "baseColor",
        "normal",
        "metallicRoughness",
        "occlusion",
        "emissive",
        "orm",
        "data"
      ],
      "description": "glTF slots, orm (packed occlusion / roughness / metalness), data (splat maps, masks, LUTs, height) or default."
    },
    "__schema23": {
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "$ref": "#/definitions/__schema1"
        }
      ]
    },
    "__schema24": {
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "$ref": "#/definitions/__schema10"
        }
      ]
    }
  }
}