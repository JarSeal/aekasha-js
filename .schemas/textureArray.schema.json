          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "__schema3": {
      "description": "three's mapping: 300 UV, 301 cube reflection, 303 equirectangular reflection.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema4"
