{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "layers": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/definitions/__schema0"
      },
      "description": "The layers, in layer index order."
    },
    "size": {
      "description": "Width and height every layer is resized to (default: the layers' size, which must then agree). The optimize step fits it into its maxSize.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema1"
        }
      ]
    },
    "texOpts": {
      "type": "object",
      "properties": {
        "mapping": {
          "type": "number"
        },
        "wrapS": {
          "type": "number"
        },
        "wrapT": {
          "type": "number"
        },
        "magFilter": {
          "type": "number"
        },
        "minFilter": {
          "type": "number"
        },
        "type": {
          "type": "number"
        },
        "anisotropy": {
          "type": "number"
        },
        "colorSpace": {
          "anyOf": [
            {
              "type": "string",
              "const": ""
            },
            {
              "type": "string",
              "const": "srgb"
            },
            {
              "type": "string",
              "const": "srgb-linear"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "optimize": {
      "type": "object",
      "properties": {
        "profile": {
          "$ref": "#/definitions/__schema2"
        },
        "slot": {
          "$ref": "#/definitions/__schema4"
        },
        "textures": {
          "$ref": "#/definitions/__schema6"
        },
        "budget": {
          "$ref": "#/definitions/__schema17"
        }
      },
      "additionalProperties": false,
      "description": "Asset optimization (p300): a profile, the slot and per-slot overrides, applied to every layer. The codec can't be none: an array is a KTX2 file."
    },
    "throwOnError": {
      "type": "boolean"
    },
    "userData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "debugData": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "number"
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "timestamp",
              "comment"
            ],
            "additionalProperties": false
          }
        },
        "todo": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "debugObj": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "__sourcePath": {
      "type": "string"
    },
    "__layers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "__url": {
      "type": "string"
    },
    "__bytes": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema22"
        }
      ]
    },
    "__vramBytes": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema22"
        }
      ]
    },
    "__codec": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema9"
        }
      ]
    }
  },
  "required": [
    "layers"
  ],
  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "string",
      "minLength": 1,
      "description": "A texture asset's id (its source file or pack, not its output), or a source image relative to this JSON (\"./source/moss.png\") or served from src/public (\"/textures/moss.png\")."
    },
    "__schema1": {
      "type": "array",
      "items": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      ],
      "minItems": 2,
      "maxItems": 2,
      "additionalItems": false
    },
    "__schema2": {
      "description": "A profile of assets.config.json.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema3"
        }
      ]
    },
    "__schema3": {
      "type": "string"
    },
    "__schema4": {
      "description": "A standalone texture's slot (default: default). A GLB's textures are classified by their material slot.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema5"
        }
      ]
    },
    "__schema5": {
      "type": "string",
      "enum": [
        "default",
        "baseColor",
        "normal",
        "metallicRoughness",
        "occlusion",
        "emissive",
        "orm",
        "data"
      ],
      "description": "glTF slots, orm (packed occlusion / roughness / metalness), data (splat maps, masks, LUTs, height) or default."
    },
    "__schema6": {
      "description": "Per-slot overrides.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema7"
        }
      ]
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "default": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "baseColor": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "normal": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "metallicRoughness": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "occlusion": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "emissive": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "orm": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        },
        "data": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema8"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema8": {
      "type": "object",
      "properties": {
        "codec": {
          "allOf": [
            {
              "$ref": "#/definitions/__schema9"
            }
          ]
        },
        "maxSize": {
          "description": "Largest side in px, downscaled to fit (null: the source size).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema10"
            }
          ]
        },
        "mipmaps": {
          "description": "Write the full mip chain (default true).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema11"
            }
          ]
        },
        "level": {
          "description": "UASTC only: --uastc-quality, 0 (fastest) to 4 (slowest).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema12"
            }
          ]
        },
        "rdo": {
          "description": "UASTC only: RDO lambda (0: off). 2 for colour, 1 for normal / ORM / data.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema13"
            }
          ]
        },
        "zstd": {
          "description": "UASTC only: Zstandard supercompression level (0: off).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema14"
            }
          ]
        },
        "quality": {
          "description": "ETC1S only: --qlevel, 1 to 255.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema15"
            }
          ]
        },
        "normalMode": {
          "description": "Two-channel normal map (X in RGB, Y in A). Needs a material that unpacks it.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema16"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema9": {
      "type": "string",
      "enum": [
        "uastc",
        "etc1s",
        "none"
      ],
      "description": "uastc: 1 B/px on every device (BC7 / ASTC 4×4), the default. etc1s: smallest download, colour slots only. none: not encoded (exact data, CPU readback)."
    },
    "__schema10": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema11": {
      "type": "boolean"
    },
    "__schema12": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "__schema13": {
      "type": "number",
      "minimum": 0
    },
    "__schema14": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "__schema15": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "__schema16": {
      "type": "boolean"
    },
    "__schema17": {
      "type": "object",
      "properties": {
        "vramMB": {
          "$ref": "#/definitions/__schema18"
        },
        "downloadMB": {
          "$ref": "#/definitions/__schema21"
        }
      },
      "additionalProperties": false,
      "description": "Per-asset limits. Set in an asset JSON's own optimize, it also replaces the per-texture ceiling (each texture's VRAM must fit its slot's maxSize and codec as set without the asset JSON's overrides)."
    },
    "__schema18": {
      "description": "Estimated GPU memory of the whole asset in MB: its textures (KTX2 at 1 B/px, the most it takes on any device) plus a GLB's geometry (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema19"
        }
      ],
      "$ref": "#/definitions/__schema20"
    },
    "__schema19": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema20": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema19"
        }
      ]
    },
    "__schema21": {
      "description": "The output file's size in MB (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema19"
        }
      ],
      "$ref": "#/definitions/__schema20"
    },
    "__schema22": {
      "type": "object",
      "properties": {
        "in": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    }
  }
}