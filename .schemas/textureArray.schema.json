      "allOf": [
        {
          "$ref": "#/definitions/__schema6"
        }
      ]
    },
    "__schema6": {
      "type": "number"
    },
    "__schema7": {
      "description": "three's vertical wrapping: 1000 repeat, 1001 clamp to edge, 1002 mirrored.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema8"
        }
      ]
    },
    "__schema8": {
      "type": "number"
    },
    "__schema9": {
      "description": "three's magnification filter: 1003 nearest, 1006 linear.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema10"
        }
      ]
    },
    "__schema10": {
      "type": "number"
    },
    "__schema11": {
      "description": "three's minification filter: 1003 nearest, 1006 linear, 1008 trilinear.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema12"
        }
