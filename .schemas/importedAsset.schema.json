          "mesh",
          "primitive",
          "extent",
          "vertices",
          "levels"
        ],
        "additionalProperties": false
      }
    },
    "__saveData": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
