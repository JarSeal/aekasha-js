  "additionalProperties": false,
  "definitions": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "string",
      "description": "Relative to this JSON file (\"./source/rock.png\", optimized into src/public/aek-assets/), or a URL path served from src/public (\"/textures/rock.png\", optionally after `path`)."
    },
    "__schema2": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "texOpts": {
              "type": "object",
              "properties": {
                "mapping": {
                  "type": "number"
                },
                "wrapS": {
                  "type": "number"
                },
                "wrapT": {
                  "type": "number"
                },
                "magFilter": {
                  "type": "number"
                },
                "minFilter": {
                  "type": "number"
                },
                "type": {
                  "type": "number"
                },
                "anisotropy": {
                  "type": "number"
                },
                "colorSpace": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": ""
                    },
                    {
                      "type": "string",
                      "const": "srgb"
                    },
                    {
                      "type": "string",
                      "const": "srgb-linear"
                    }
                  ]
                }
              },
              "additionalProperties": false
            },
            "isPersistent": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "__schema3": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      ]
    },
    "__schema4": {
      "type": "boolean"
    },
    "__schema5": {
      "anyOf": [
        {
          "$ref": "#/definitions/__schema6"
        },
        {
          "$ref": "#/definitions/__schema7"
        }
      ],
      "description": "Generate a LOD chain (p347) for every rendered geometry of the import after it loads: true for the default options, or the options. Nothing selects a level until p348's `lod` on a mesh. Skinned and morph-target geometry is skipped."
    },
    "__schema6": {
      "type": "boolean"
    },
    "__schema7": {
      "type": "object",
      "properties": {
        "ratios": {
          "$ref": "#/definitions/__schema8"
        },
        "maxError": {
          "$ref": "#/definitions/__schema10"
        },
        "attributeWeights": {
          "$ref": "#/definitions/__schema12"
        },
        "compactVertices": {
          "$ref": "#/definitions/__schema14"
        },
        "lockBorder": {
          "$ref": "#/definitions/__schema16"
        },
        "permissive": {
          "$ref": "#/definitions/__schema18"
        }
      },
      "additionalProperties": false,
      "description": "generateLodChain options."
    },
    "__schema8": {
      "description": "Target triangle counts, as ratios of the base's, one per level. Default [0.5, 0.25, 0.1].",
      "allOf": [
        {
          "$ref": "#/definitions/__schema9"
        }
      ]
    },
    "__schema9": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0,
        "exclusiveMaximum": 1
      }
    },
    "__schema10": {
      "description": "meshoptimizer's target error cap, relative to the mesh's extent (its largest bounding box side). Default 0.05.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema11"
        }
      ]
    },
    "__schema11": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "__schema12": {
      "description": "How much normal and uv deviation count against a collapse. Default 0.5 each (0 ignores it).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema13"
        }
      ]
    },
    "__schema13": {
      "type": "object",
      "properties": {
        "normal": {
          "type": "number",
          "minimum": 0
        },
        "uv": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "__schema14": {
      "description": "Each level gets its own trimmed vertex arrays instead of sharing the base's. Better for large meshes whose far levels use few vertices. Default false.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema15"
        }
      ]
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "description": "Keeps the mesh's open borders in place, so tiling geometry still meets its neighbours. Default false.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema17"
        }
      ]
    },
    "__schema17": {
      "type": "boolean"
    },
    "__schema18": {
      "description": "Lets collapses cross attribute seams. Flat-shaded geometry (a normal per face) doesn't simplify without it. Default false.",
      "allOf": [
        {
          "$ref": "#/definitions/__schema19"
        }
      ]
    },
    "__schema19": {
      "type": "boolean"
    },
    "__schema20": {
      "type": "boolean"
    },
    "__schema21": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "number"
              },
              "comment": {
                "type": "string"
              }
            },
            "required": [
              "timestamp",
              "comment"
            ],
            "additionalProperties": false
          }
        },
        "todo": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        },
        "debugObj": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "additionalProperties": false
    },
    "__schema22": {
      "type": "boolean",
      "const": false
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "profile": {
          "description": "A profile of assets.config.json.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema24"
            }
          ]
        },
        "textures": {
          "description": "Per-slot overrides, or false to keep the textures as they are.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema25"
            }
          ]
        },
        "mesh": {
          "description": "Overrides, or false to keep the geometry as it is.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema34"
            }
          ]
        },
        "budget": {
          "type": "object",
          "properties": {
            "vramMB": {
              "$ref": "#/definitions/__schema38"
            },
            "downloadMB": {
              "$ref": "#/definitions/__schema41"
            }
          },
          "additionalProperties": false,
          "description": "Per-asset limits. Set in an asset JSON's own optimize, it also replaces the per-texture ceiling (each texture's VRAM must fit its slot's maxSize and codec as set without the asset JSON's overrides)."
        }
      },
      "additionalProperties": false
    },
    "__schema24": {
      "type": "string"
    },
    "__schema25": {
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "baseColor": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "normal": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "metallicRoughness": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "occlusion": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "emissive": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "orm": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            },
            "data": {
              "allOf": [
                {
                  "$ref": "#/definitions/__schema26"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "__schema26": {
      "type": "object",
      "properties": {
        "codec": {
          "type": "string",
          "enum": [
            "uastc",
            "etc1s",
            "none"
          ],
          "description": "uastc: 1 B/px on every device (BC7 / ASTC 4×4), the default. etc1s: smallest download, colour slots only. none: not encoded (exact data, CPU readback)."
        },
        "maxSize": {
          "description": "Largest side in px, downscaled to fit (null: the source size).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema27"
            }
          ]
        },
        "mipmaps": {
          "description": "Write the full mip chain (default true).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema28"
            }
          ]
        },
        "level": {
          "description": "UASTC only: --uastc-quality, 0 (fastest) to 4 (slowest).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema29"
            }
          ]
        },
        "rdo": {
          "description": "UASTC only: RDO lambda (0: off). 2 for colour, 1 for normal / ORM / data.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema30"
            }
          ]
        },
        "zstd": {
          "description": "UASTC only: Zstandard supercompression level (0: off).",
          "allOf": [
            {
              "$ref": "#/definitions/__schema31"
            }
          ]
        },
        "quality": {
          "description": "ETC1S only: --qlevel, 1 to 255.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema32"
            }
          ]
        },
        "normalMode": {
          "description": "Two-channel normal map (X in RGB, Y in A). Needs a material that unpacks it.",
          "allOf": [
            {
              "$ref": "#/definitions/__schema33"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "__schema27": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 4,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema28": {
      "type": "boolean"
    },
    "__schema29": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "__schema30": {
      "type": "number",
      "minimum": 0
    },
    "__schema31": {
      "type": "integer",
      "minimum": 0,
      "maximum": 22
    },
    "__schema32": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "__schema33": {
      "type": "boolean"
    },
    "__schema34": {
      "anyOf": [
        {
          "type": "boolean",
          "const": false
        },
        {
          "type": "object",
          "properties": {
            "codec": {
              "description": "Geometry compression. meshopt (default) also shrinks VRAM when quantized.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema35"
                }
              ]
            },
            "quantize": {
              "description": "Quantize, reorder and filter the vertices. false: lossless (EXT_meshopt_compression alone), the collider default.",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema36"
                }
              ]
            },
            "simplify": {
              "description": "Target triangle ratio (null: off).",
              "allOf": [
                {
                  "$ref": "#/definitions/__schema37"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "__schema35": {
      "type": "string",
      "enum": [
        "meshopt",
        "draco",
        "none"
      ]
    },
    "__schema36": {
      "type": "boolean"
    },
    "__schema37": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema38": {
      "description": "Estimated GPU memory of the whole asset in MB: its textures (KTX2 at 1 B/px, the most it takes on any device) plus a GLB's geometry (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema39"
        }
      ],
      "$ref": "#/definitions/__schema40"
    },
    "__schema39": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "__schema40": {
      "allOf": [
        {
          "$ref": "#/definitions/__schema39"
        }
      ]
    },
    "__schema41": {
      "description": "The output file's size in MB (null: no limit).",
      "allOf": [
        {
          "$ref": "#/definitions/__schema39"
        }
      ],
      "$ref": "#/definitions/__schema40"
    },
    "__schema42": {
      "type": "object",
      "properties": {
        "in": {
          "type": "number"
        },
        "out": {
          "type": "number"
        }
      },
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false
    },
    "__schema43": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  }
}