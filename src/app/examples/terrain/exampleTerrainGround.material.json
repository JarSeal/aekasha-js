{
  "$schema": "../../../../.schemas/material.schema.json",
  "id": "exampleTerrainGround",
  "tslFile": "examples/terrain/exampleTerrainGround.tsl.ts",
  "type": "STANDARDNODEMATERIAL",
  "staticDefines": {
    "terrain": {
      "layers": [{}, {}, {}, { "projection": { "mode": "TRIPLANAR", "slopeGate": [35, 50] } }],
      "blend": {
        "source": "VERTEX_COLOR",
        "vertexColor": { "layout": "RGB_AO" },
        "mode": "HEIGHT"
      },
      "ao": { "vertex": true },
      "antiTiling": { "mode": "DUAL_SCALE" },
      "macro": { "scale": 64 }
    }
  },
  "inputs": {
    "layer0": { "textureSet": "grass01" },
    "layer1": { "textureSet": "rocks02" },
    "layer2": { "textureSet": "snow01" },
    "layer3": { "textureSet": "cliffs02" },
    "macro": { "texture": "macroNoise" }
  },
  "debugData": {
    "name": "Terrain example ground",
    "description": "The terrain example's block material: grass01, rocks02, snow01 and cliffs02 weighed by the vertex colours its generator's rules laid (RGB_AO, the horizon AO in A) through the height blend, DUAL_SCALE anti-tiling, cliffs02 triplanar past a 35-50° slope gate, the macro variation."
  }
}
