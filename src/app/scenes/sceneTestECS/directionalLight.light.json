  "entityOpts": {
    "appId": "directionalLight",
    "debugData": {
      "name": "Sun",
      "description": "The shadow-casting sun. Its shadow frustum covers the meshes, not the whole ground: a larger one spreads the same shadow map over more ground."
    }
  }
