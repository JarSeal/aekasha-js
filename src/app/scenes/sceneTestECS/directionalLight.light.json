{
  "$schema": "../../../../.schemas/light.schema.json",
  "lightProps": {
    "type": "DIRECTIONAL",
    "color": "#ffe5c7",
    "intensity": 3,
    "position": { "x": 5, "y": 10, "z": 6 },
    "targetPos": { "x": 0, "y": 0, "z": 0 },
    "castShadow": true,
    "shadowPreset": "HIGH",
    "shadowCameraNearFar": [1, 30],
    "shadowCameraFrustum": [-8, 8, 8, -8],
    "shadowIntensity": 0.75
